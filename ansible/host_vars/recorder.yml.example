---
# ansible/host_vars/recorder.yml（gitignore 済み）にコピーして実値を記入する

recording_disks:
  - device: /dev/disk/by-id/ata-WDC_REPLACE_ME
    mountpoint: /mnt/recording-disk-1
    fstype: ext4
  - device: /dev/disk/by-id/ata-ST_REPLACE_ME
    mountpoint: /mnt/recording-disk-2
    fstype: ext4

nvidia_enabled: false
tuner_enabled: false
apps_enabled: false
github_runner_enabled: false

# tuner_driver: px4_drv
# tuner_px4_drv_firmware_zip_url: http://plex-net.co.jp/plex/pxw3u4/pxw3u4_BDA_ver1x64.zip
