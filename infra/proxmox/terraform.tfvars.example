#     id      = "0511:083f"
#   }
#   bcas-reader = {
#     comment = "SCR3310 スマートカードリーダ"
#     id      = "04e6:5116"
#   }
# }
usb_hardware_mappings = {}

# pci_passthrough = [
#   { device = "hostpci0", mapping = "gpu-gtx1050" },
# ]
pci_passthrough = []

# usb_passthrough = [
#   { mapping = "tuner" },
#   { mapping = "bcas-reader" },
# ]
usb_passthrough = []

# recording_disk_passthrough = [
#   { device = "/dev/disk/by-id/ata-WDC_REPLACE_ME", size_gb = 1862 },
#   { device = "/dev/disk/by-id/ata-ST_REPLACE_ME",  size_gb = 3726 },
# ]
recording_disk_passthrough = []
