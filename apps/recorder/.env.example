# .env（gitignore 済み）にコピーしてパスワードを変更する。MariaDB は compose ネットワーク内
# からしか到達できないが、それでもこの値をコミットしてはいけない
TZ=Asia/Tokyo
RECORDINGS_DIR=/srv/recordings

DB_NAME=epgstation
DB_USER=epgstation
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# GPU passthrough 前は libx264、その後 nvenc
ENCODER=libx264

MIRAKURUN_LOG_LEVEL=2
